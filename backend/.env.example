# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- LLM Provider: Google Gemini (free tier, no credit card required) ---
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for extraction + scoring. gemini-2.5-flash is on Google's free tier.
LLM_MODEL=gemini-2.5-flash

# --- Server ---
PORT=5000

# Comma-separated list of origins allowed to call this API (for CORS)
CORS_ORIGIN=http://localhost:5173