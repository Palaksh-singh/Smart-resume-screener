# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- LLM Provider: Google Gemini (free tier, no credit card required) ---
# Get a free key from https://aistudio.google.com/apikey
GROQ_API_KEY=your_groq_api_key_here
# Model used for extraction + scoring. Updated to a supported model.
LLM_MODEL=llama-3.3-70b-versatile

# --- Server ---
# Port changed from 5000 to 5001 to avoid EADDRINUSE errors
PORT=5001

# Comma-separated list of origins allowed to call this API (for CORS)
CORS_ORIGIN=http://localhost:5173